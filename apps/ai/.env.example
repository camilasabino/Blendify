# development (default) or production. Production refuses to start without a strong token.
AI_SERVICE_ENV=development
# Shared with the API (apps/api/.env AI_SERVICE_TOKEN). Every route except /health requires
# `Authorization: Bearer <token>`; without a token those routes reject every request.
# This authenticates API -> AI service; it is not a model-provider credential.
AI_SERVICE_TOKEN=local-ai-service-token-change-me-0123456789
# Required, no code default: a registered model provider (currently openai), or disabled
# (interpretation reports unavailable and no model is called).
# With a real provider, every interpretation request is a paid model call.
AI_PROVIDER=openai
# Required by real providers, no code default. Opaque to the service: the provider adapter
# decides what it means. Not used by disabled. Example for the openai provider:
AI_MODEL=gpt-5.6-luna

# Required by real providers. Authenticates AI service -> configured model provider. Only read
# by this service; never add it to the API or web.
# AI_PROVIDER_API_KEY=

# ALLOW_PAID_AI_EVALS is never set here: the paid eval accepts it only on the command line.
