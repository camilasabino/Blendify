# development (default) or production. Production refuses to start without a strong token.
AI_SERVICE_ENV=development
# Shared with the API (apps/api/.env AI_SERVICE_TOKEN). Every route except /health requires
# `Authorization: Bearer <token>`; without a token those routes reject every request.
AI_SERVICE_TOKEN=local-ai-service-token-change-me-0123456789
# Required, no code default: openai, or disabled (interpretation reports unavailable).
# With openai, every interpretation request is a paid model call.
AI_PROVIDER=openai
# Required when AI_PROVIDER=openai, no code default.
AI_MODEL=gpt-5.6-luna

# Required when AI_PROVIDER=openai. Only read by this service; never add it to the API or web.
# OPENAI_API_KEY=

# ALLOW_PAID_AI_EVALS is never set here: the paid eval accepts it only on the command line.
