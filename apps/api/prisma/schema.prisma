generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  spotifyId      String          @unique
  displayName    String
  email          String?
  imageUrl       String?
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  playlists      Playlist[]
  seedUsages     SeedUsage[]
  usageStats     UserUsageStats?

  @@map("users")
}

model UserUsageStats {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistMixCount Int      @default(0)
  genreMixCount  Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("user_usage_stats")
}

/// Seed usage survives Library deletions and non-persisted generations.
model SeedUsage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       SeedKind
  seedKey    String
  name       String
  imageUrl   String?
  useCount   Int      @default(0)
  lastUsedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, kind, seedKey])
  @@index([userId, kind, useCount])
  @@map("seed_usages")
}

enum SeedKind {
  ARTIST
  GENRE
}

model Playlist {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String         @default("")
  spotifyId        String?
  spotifyUrl       String?
  kind             String
  status           PlaylistStatus @default(PENDING)
  totalDurationMs  Int            @default(0)
  seedCount        Int            @default(0)
  trackCount       Int            @default(0)
  tracksPerSeed    Int?
  seeds            Json
  tracks           Json
  generation       Json
  missingOnSpotify Boolean        @default(false)
  syncedTrackCount Int?
  imageUrl         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId, createdAt])
  @@map("playlists")
}

enum PlaylistStatus {
  PENDING
  COMPLETED
  FAILED
}
