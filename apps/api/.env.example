# Application
NODE_ENV=development
PORT=3000
# Use localhost (not 127.0.0.1) so Secure session cookies work on local HTTP.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

DATABASE_URL=postgresql://blendify:blendify@localhost:5432/blendify?schema=public
REDIS_URL=redis://localhost:6379

# Request protection
# Proxy trust for client IP resolution. Default false: X-Forwarded-For is ignored.
# Use a hop count (e.g. 2) or comma-separated IPs/CIDRs/loopback/uniquelocal. `true` is rejected.
TRUST_PROXY=false
# Optional rate-limit overrides: comma-separated bucket=limit/windowSeconds.
# Buckets: search, similar, resolve, generation. Defaults live in code.
# RATE_LIMIT_OVERRIDES=generation=12/600,search=60/60
# Concurrent generations per client (user ID or client IP) and across all API instances.
GENERATION_CONCURRENCY_PER_CLIENT=2
GENERATION_CONCURRENCY_GLOBAL=6

JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-me-cookie-secret

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback
SPOTIFY_CATALOG_MARKET=AR
SPOTIFY_SCOPES=user-read-email user-read-private playlist-read-private playlist-modify-public playlist-modify-private ugc-image-upload user-read-playback-state user-modify-playback-state

# Last.fm (https://www.last.fm/api/account/create) — required for similar artists
LASTFM_API_KEY=
