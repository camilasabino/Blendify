# Application
NODE_ENV=development
PORT=3000
# Canonical local origin. Spotify rejects `localhost` redirect URIs; loopback IPs are allowed.
# Production: https://blendify.camilasabino.dev (https origin, no trailing slash).
FRONTEND_URL=http://127.0.0.1:5173

DATABASE_URL=postgresql://blendify:blendify@localhost:5432/blendify?schema=public
REDIS_URL=redis://localhost:6379

# Request protection
# Proxy trust for client IP resolution. Default false: X-Forwarded-For is ignored.
# Use a hop count (e.g. 1) or comma-separated IPs/CIDRs/loopback/uniquelocal. `true` is rejected.
# Production (Railway edge in front of the API): 1. `false` is rejected in production.
TRUST_PROXY=false
# Source of the anonymous client IP used by rate limits and generation concurrency.
# express (default): Express `req.ip`, which follows TRUST_PROXY.
# railway-x-forwarded-for: left-most X-Forwarded-For entry written by the Railway edge.
# Required in production; Railway production uses railway-x-forwarded-for.
CLIENT_IP_SOURCE=express
# Optional rate-limit overrides: comma-separated bucket=limit/windowSeconds.
# Buckets: search, similar, resolve, generation, transfer. Defaults live in code.
# RATE_LIMIT_OVERRIDES=generation=12/600,search=60/60
# Concurrent generations per client (user ID or client IP) and across all API instances.
GENERATION_CONCURRENCY_PER_CLIENT=2
GENERATION_CONCURRENCY_GLOBAL=6

# Guest playlist transfer through Soundiiz (POST /api/transfers). Keep false in
# production until the Spotify Developer Policy review clears transferring
# Guest playlists built from Spotify catalog metadata. Accepts true or false.
GUEST_TRANSFER_ENABLED=false

# Session JWT signing key (also derives the transfer-token key). Production requires
# at least 32 random characters. The session lifetime is fixed at 7 days in code.
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# Spotify OAuth (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Production: https://api.blendify.camilasabino.dev/api/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
SPOTIFY_CATALOG_MARKET=AR
SPOTIFY_SCOPES=user-read-email user-read-private playlist-read-private playlist-modify-public playlist-modify-private ugc-image-upload user-read-playback-state user-modify-playback-state

# Last.fm (https://www.last.fm/api/account/create) — required for similar artists
LASTFM_API_KEY=
