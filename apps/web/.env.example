# Public API origin compiled into the bundle (never put secrets in VITE_* variables).
# Required for production builds: https origin without path or trailing slash.
# Production: https://api.blendify.camilasabino.dev
VITE_API_URL=http://127.0.0.1:3000

# Shows Create with AI (/app/ai). Defaults to on in dev and off in production builds.
VITE_AI_CREATION_ENABLED=
