{
  "name": "blendify",
  "version": "1.0.0",
  "private": true,
  "description": "Create and discover Spotify playlists from artists, genres, or songs, with optional Soundiiz transfer",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run start:dev -w @blendify/api",
    "dev:web": "npm run dev -w @blendify/web",
    "dev:ai": "uv run --directory apps/ai --env-file .env uvicorn --factory app.main:create_app --reload --host 127.0.0.1 --port 8000",
    "build": "npm run build:api && npm run build -w @blendify/web",
    "build:contracts": "npm run build -w @blendify/contracts",
    "build:api": "npm run build:contracts && npm run prisma:generate -w @blendify/api && npm run build -w @blendify/api",
    "build:web": "npm run build:contracts && npm run build -w @blendify/web",
    "check:railway": "tsc -p .railway/tsconfig.json",
    "pretest": "npm run build:contracts",
    "test": "npm run test --workspaces --if-present",
    "pretest:api": "npm run build:contracts",
    "test:api": "npm run test -w @blendify/api",
    "test:web": "npm run test -w @blendify/web",
    "test:ai": "uv run --directory apps/ai pytest",
    "test:e2e": "npm run test:e2e -w @blendify/web",
    "sonar:coverage": "node scripts/merge-sonar-coverage.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:ai": "uv run --directory apps/ai ruff check . && uv run --directory apps/ai ruff format --check .",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "ai:sync": "uv sync --directory apps/ai --locked",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w @blendify/api",
    "db:generate": "npm run prisma:generate -w @blendify/api",
    "start": "./scripts/start.sh",
    "stop": "./scripts/stop.sh",
    "stop:all": "./scripts/stop.sh --infra",
    "restart": "./scripts/restart.sh",
    "reset": "./scripts/reset.sh --yes",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "railway": "3.11.0"
  }
}
