# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql://blendify:blendify@localhost:5432/blendify?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Session / JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-me-cookie-secret

# Spotify OAuth (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
SPOTIFY_SCOPES=user-read-email user-read-private playlist-modify-public playlist-modify-private ugc-image-upload user-read-playback-state user-modify-playback-state
